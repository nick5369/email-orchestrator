# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (Neon PostgreSQL free plan or local docker)
# Production Neon URL: postgresql://user:pass@ep-XXX.us-east-2.aws.neon.tech/email_orchestrator?sslmode=require
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/email_orchestrator?schema=public"

# Redis Configuration (Upstash free plan or Local Redis)
# Production: Use Upstash Redis TLS URL
REDIS_URL=rediss://default:YOUR_UPSTASH_REDIS_PASSWORD@YOUR_HOST.upstash.io:6379
# Local dev: use these instead
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch / OpenSearch (Bonsai.io free plan or local)
# Production: https://USER:PASS@YOUR_CLUSTER.bonsaisearch.net
ELASTICSEARCH_NODE=http://localhost:9200

# Security Secrets (Must be unique 32-char keys in production)
JWT_SECRET=email_orchestrator_super_secret_jwt_key_dev
ENCRYPTION_SECRET=email_orchestrator_aes_secret_32bytes!! # Must be exactly 32 chars

# Ethereal SMTP (Optional overrides if not using dynamic test accounts)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=your_ethereal_user@ethereal.email
ETHEREAL_PASS=your_ethereal_password

# Real SMTP Overrides (Optional: for actual inbox delivery)
REAL_SMTP_HOST=
REAL_SMTP_PORT=587
REAL_SMTP_USER=
REAL_SMTP_PASS=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth 2.0
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Worker Configuration
WORKER_CONCURRENCY=10
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=100
